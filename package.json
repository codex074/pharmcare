{
  "name": "pharmcare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:up": "docker compose -f dev/docker-compose.yml up -d",
    "db:down": "docker compose -f dev/docker-compose.yml down",
    "db:reset": "docker compose -f dev/docker-compose.yml down -v && docker compose -f dev/docker-compose.yml up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.3",
    "jose": "6.2.12",
    "next": "16.3.8",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.8",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
