# pharmcare database as pharmcare_app (runtime: SELECT/INSERT/UPDATE, no DELETE)
DATABASE_URL=postgres://pharmcare_app:dev-app-pass@127.0.0.1:54329/pharmcare
# pharmshift's `postgres` database as pharmcare_app (column-level SELECT on public.users)
AUTH_DATABASE_URL=postgres://pharmcare_app:dev-app-pass@127.0.0.1:54329/postgres
# pharmcare database as pharmcare_owner (drizzle-kit migrations only)
MIGRATION_DATABASE_URL=postgres://pharmcare_owner:dev-owner-pass@127.0.0.1:54329/pharmcare
# openssl rand -base64 48 — must differ from pharmshift's secret
SESSION_JWT_SECRET=
# his-relay base URL; leave empty to type patient name/clinic manually
HIS_RELAY_URL=
# his-relay auth (only needed when HIS_RELAY_URL is set)
HIS_RELAY_CF_ACCESS_CLIENT_ID=
HIS_RELAY_CF_ACCESS_CLIENT_SECRET=
HIS_RELAY_SECRET=
