# his-relay config. Copy to relay/.env (gitignored) and fill in.
# Runs on an always-on machine INSIDE the hospital LAN (can reach the queue API).

# Port the relay listens on (cloudflared points here).
RELAY_PORT=4000

# Pharmacy queue API base URL on the hospital LAN.
QUEUE_API_URL=http://172.17.1.240/api/v1

# Dedicated PharmCare service account for the queue API (NOT a personal login).
QUEUE_USERNAME=
QUEUE_PASSWORD=

# Shared secret the app sends as the X-Relay-Secret header. Must equal the
# web app's HIS_RELAY_SECRET. Generate a long random value.
RELAY_SHARED_SECRET=
